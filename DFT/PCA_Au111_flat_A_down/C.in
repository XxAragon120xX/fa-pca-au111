&CONTROL
  calculation   = 'scf'
  restart_mode  = 'from_scratch'
  max_seconds   = 3300
  prefix      = 'PCA_Au111_flat_A_down_C'
  outdir        = './tmp'
  pseudo_dir    = '/home/dagiraldo/Au/Pseudos/'
/

&SYSTEM
  ibrav         = 0
  nat         = 20
  ntyp        = 4
  ecutwfc       = 60
  ecutrho       = 600
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.01
  vdw_corr      = 'grimme-d3'
  dftd3_version = 4
  nosym         = .true.
/

&ELECTRONS
  conv_thr         = 1.0d-8
  mixing_beta      = 0.2
  mixing_mode      = 'local-TF'
  mixing_ndim      = 16
  electron_maxstep = 800
  diagonalization  = 'david'
  startingwfc      = 'atomic+random'
/

