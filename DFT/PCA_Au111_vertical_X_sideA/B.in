&CONTROL
  calculation   = 'scf'
  restart_mode  = 'from_scratch'
  prefix        = 'B'
  outdir        = './tmp'
  pseudo_dir    = './pseudo/'
  tprnfor       = .true.
  tstress       = .true.
/

&SYSTEM
  ibrav         = 0
  nat           = 100
  ntyp          = 1
  ecutwfc       = 60
  ecutrho       = 600
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.01
  vdw_corr      = 'grimme-d3'
