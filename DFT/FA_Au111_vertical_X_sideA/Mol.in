&CONTROL
  calculation   = 'scf'
  restart_mode  = 'from_scratch'
  prefix        = 'Mol'
  outdir        = './tmp'
  pseudo_dir    = './pseudo/'
  tprnfor       = .true.
  tstress       = .true.
/

&SYSTEM
  ibrav         = 0
  nat           = 51
  ntyp          = 4
  ecutwfc       = 70
  ecutrho       = 700
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.01
  vdw_corr      = 'grimme-d3'
  dftd3_version = 4
  nosym         = .true.
/

&ELECTRONS
  conv_thr         = 1.0d-8
  mixing_beta      = 0.3
  mixing_mode      = 'local-TF'
  electron_maxstep = 500
  diagonalization  = 'david'
/

