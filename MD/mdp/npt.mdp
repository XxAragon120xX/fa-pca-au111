; 2 ns NPT semiisotrópico (solo z) para ajustar la densidad del agua; Au y ligando restringidos
define               = -DPOSRES_LIG -DPOSRES_AU
integrator           = md
dt                   = 0.002
nsteps               = 1000000
nstxout-compressed   = 5000
nstenergy            = 1000
nstlog               = 5000
continuation         = yes
gen_vel              = no
constraints          = h-bonds
constraint_algorithm = lincs
tcoupl               = V-rescale
tc-grps              = System
tau_t                = 0.1
ref_t                = 298.15
pcoupl               = C-rescale
pcoupltype           = semiisotropic
tau_p                = 2.0
ref_p                = 1.0 1.0
compressibility      = 0 4.5e-5
refcoord_scaling     = com
comm-mode            = Linear
comm-grps            = System
cutoff-scheme        = Verlet
nstlist              = 20
coulombtype          = PME
rcoulomb             = 1.2
vdwtype              = Cut-off
rvdw                 = 1.2
fourierspacing       = 0.12
DispCorr             = no
pbc                  = xyz
