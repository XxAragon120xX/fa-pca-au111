; 1 ns NVT, 298 K, Au congelado, ligando restringido
define               = -DPOSRES_LIG
integrator           = md
dt                   = 0.002
nsteps               = 500000
nstxout-compressed   = 5000
nstenergy            = 1000
nstlog               = 5000
continuation         = no
gen_vel              = yes
gen_temp             = 298.15
gen_seed             = -1
constraints          = h-bonds
constraint_algorithm = lincs
tcoupl               = V-rescale
tc-grps              = System
tau_t                = 0.1
ref_t                = 298.15
pcoupl               = no
freezegrps           = AU
freezedim            = Y Y Y
comm-mode            = Linear
comm-grps            = nonAU
cutoff-scheme        = Verlet
nstlist              = 20
coulombtype          = PME
rcoulomb             = 1.2
vdwtype              = Cut-off
rvdw                 = 1.2
fourierspacing       = 0.12
DispCorr             = no
pbc                  = xyz
