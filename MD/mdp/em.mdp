; minimización con el Au congelado
integrator           = steep
emtol                = 1000.0
emstep               = 0.001
nsteps               = 50000
freezegrps           = AU
freezedim            = Y Y Y
constraints          = h-bonds
cutoff-scheme        = Verlet
nstlist              = 20
coulombtype          = PME
rcoulomb             = 1.2
vdwtype              = Cut-off
rvdw                 = 1.2
fourierspacing       = 0.12
DispCorr             = no
pbc                  = xyz
