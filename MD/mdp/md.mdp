; producción NVT, 200 ns, Au congelado, sin restricciones sobre el ligando
integrator           = md
dt                   = 0.002
nsteps               = 100000000
nstxout              = 500000
nstvout              = 0
nstxout-compressed   = 5000
compressed-x-grps    = LIG
nstenergy            = 5000
nstlog               = 50000
continuation         = yes
gen_vel              = no
constraints          = h-bonds
constraint_algorithm = lincs
tcoupl               = V-rescale
tc-grps              = System
tau_t                = 0.1
ref_t                = 298.15
pcoupl               = no
freezegrps           = AU
freezedim            = Y Y Y
comm-mode            = Linear
comm-grps            = nonAU
cutoff-scheme        = Verlet
nstlist              = 20
coulombtype          = PME
rcoulomb             = 1.2
vdwtype              = Cut-off
rvdw                 = 1.2
fourierspacing       = 0.12
DispCorr             = no
pbc                  = xyz
