define               = -DPOSRES
integrator           = md
dt                   = 0.002
nsteps               = 50000
nstxout-compressed   = 5000
nstenergy            = 1000
nstlog               = 1000
continuation         = no
constraints          = h-bonds
constraint_algorithm = lincs
cutoff-scheme        = Verlet
nstlist              = 10
coulombtype          = PME
rcoulomb             = 1.0
rvdw                 = 1.0
DispCorr             = EnerPres
tcoupl               = V-rescale
tc-grps              = Protein Non-Protein
tau_t                = 0.1 0.1
ref_t                = 310 310
pcoupl               = no
gen_vel              = yes
gen_temp             = 310
gen_seed             = -1
pbc                  = xyz
